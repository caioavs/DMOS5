<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="@color/brown_strong">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                app:title=" ">

                <ImageButton
                    android:id="@+id/btnDrawer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/drawer"
                    android:background="@android:color/transparent" />

            </androidx.appcompat.widget.Toolbar>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="46dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="55dp">

                        <ImageButton
                            android:id="@+id/btnReturn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:padding="10dp"
                            android:src="@drawable/back_arrow"
                            android:background="@android:color/transparent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:text="Novo Pedido"
                            android:fontFamily="@font/flux_regular"
                            android:textSize="35sp"
                            android:textStyle="bold"
                            android:textColor="@color/beige" />
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:text="Prato principal"
                        android:fontFamily="@font/flux_regular"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/yellow_orange" />

                    <Spinner
                        android:id="@+id/spPratoPrincipal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="35dp"
                        android:padding="15dp"
                        android:dropDownWidth="wrap_content"
                        android:background="@drawable/custom_sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:text="Prato adicional"
                        android:fontFamily="@font/flux_regular"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/brown" />

                    <Spinner
                        android:id="@+id/spPratoAdicional"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="35dp"
                        android:padding="15dp"
                        android:dropDownWidth="wrap_content"
                        android:background="@drawable/custom_sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:text="Bebida"
                        android:fontFamily="@font/flux_regular"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/brown" />

                    <Spinner
                        android:id="@+id/spBebida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="55dp"
                        android:background="@drawable/custom_sp"
                        android:dropDownWidth="wrap_content"
                        android:padding="15dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="55dp"
                        android:textColorHint="@color/brown_light"
                        app:hintTextColor="@color/gray_light">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etObservacoes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="13dp"
                            android:hint="Observações"
                            android:fontFamily="@font/flux_regular"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/brown_lighter" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnPlaceOrder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="15dp"
                        android:background="@drawable/custom_btn"
                        android:text="Concluir"
                        android:fontFamily="@font/choplin_medium"
                        android:textSize="18sp"
                        android:letterSpacing="0.2"
                        android:textColor="@color/brown_strong_light"
                        app:backgroundTint="@color/black" />

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/drawer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            app:menu="@menu/drawer" />

    </androidx.drawerlayout.widget.DrawerLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
